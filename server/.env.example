# Render supplies PORT automatically.
PORT=3000

# Add the private MongoDB Atlas connection string in Render Environment.
MONGODB_URI=mongodb+srv://<db-user>:<db-password>@<cluster-host>/privatecall?retryWrites=true&w=majority

# Generate a long random secret (at least 32 characters). Never commit the real value.
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-characters

# Native Android does not require browser CORS. Restrict if a web client is added.
CLIENT_ORIGIN=*
